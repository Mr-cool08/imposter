APP_NAME="Imposter Party"
HOST=127.0.0.1
PORT=5000
IMPOSTER_DEBUG=false

# Tillfällig slumpnyckel vid tomt värde. Ange ett eget värde för drift.
SECRET_KEY=

# Ange för en offentlig HTTPS-adress, utan sökväg eller avslutande snedstreck.
PUBLIC_ORIGIN=
# En blankstegsseparerad lista över tillåtna värdnamn, exempelvis spel.example.com.
TRUSTED_HOSTS=
# Lämna 0 utan betrodd proxy. Sätt till antal betrodda proxyled annars.
PROXY_HOPS=0

ONLINE_MAX_ROOMS=5
ONLINE_ROOM_TTL_SECONDS=7200
ONLINE_MAX_PACKET_BYTES=196608
ONLINE_MAX_CUSTOM_BYTES=131072
ONLINE_HISTORY_LIMIT=30
